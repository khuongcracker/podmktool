# Copy sang .env rồi điền. KHÔNG commit .env.

# Key AI — chỉ sống ở đây, không bao giờ đi ra browser
GEMINI_API_KEY=
OPENAI_API_KEY=

PORT=8787
DB_PATH=./data/app.db

# Phiên không hoạt động quá số phút này sẽ tự đóng và ghi end_reason='expired'
SESSION_IDLE_MIN=480

# Bật thành 1 khi deploy sau HTTPS (cookie chỉ gửi qua kết nối mã hoá)
SECURE_COOKIE=0

UPSTREAM_TIMEOUT_MS=120000
